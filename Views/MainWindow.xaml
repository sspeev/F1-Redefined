<Window x:Class="F1_Redefined.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Resources/Images/app.ico"
        Title="F1 Flag Lights" Height="500" Width="720" Background="#F3F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="F1 FLAG LIGHTS" FontSize="24" FontWeight="Bold" Foreground="#17212B"/>
            <TextBlock Text="Live race control, reflected instantly on your lights."
                       Foreground="#64717D" Margin="0,3,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#DCE2E7" BorderThickness="1"
                Padding="14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="LIGHT CONNECTION" FontSize="12" FontWeight="Bold" Foreground="#64717D"/>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Govee Sofia" Foreground="#17212B" Margin="0,0,0,5"/>
                    <TextBlock Text="Gaming Bars (Tuya)" Foreground="#17212B" Margin="0,0,0,5"/>
                    <TextBlock Text="Govee Burgas" Foreground="#17212B"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DCE2E7" BorderThickness="1"
                Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CURRENT FLAG" FontSize="12" FontWeight="Bold" Foreground="#64717D" VerticalAlignment="Center"/>
                <Border x:Name="FlagIndicator" Width="24" Height="24" Background="Gray" Margin="14,0,8,0"/>
                <TextBlock x:Name="FlagText" Text="Waiting for race control" FontSize="16" FontWeight="SemiBold"
                           Foreground="#17212B" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3">
            <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" FontSize="12" FontWeight="Bold" Foreground="#64717D" Margin="0,0,0,5"/>
            <TextBox x:Name="LogBox"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>
